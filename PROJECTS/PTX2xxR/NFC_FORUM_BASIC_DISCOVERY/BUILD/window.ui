<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object id="window" class="GtkWindow">
    <property name="title">PTX205R</property>
    <property name="default-width">700</property>
    <property name="default-height">600</property>
    <child type="titlebar">
      <object class="GtkHeaderBar" id="header">
        <child type="title">
          <object class="GtkStackSwitcher" id="stackSwitcher">
            <property name="stack">mainStack</property>
          </object>
        </child>
        <child type="end">
          <object class="GtkMenuButton" id="menu">
            <property name="direction">none</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object id="mainStack" class="GtkStack">
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <property name="transition-type">crossfade</property>
        <property name="visible-child-name">discovery</property>
        <child>
          <object class="GtkStackPage">
            <property name="name">polling</property>
            <property name="title">Polling</property>
            <property name="child">
              <object id="pollingScroll" class="GtkScrolledWindow">
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <child>
                  <object id="pollingBox" class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <property name="margin-start">8</property>
                    <property name="margin-end">8</property>
                    <property name="margin-top">8</property>
                    <property name="margin-bottom">8</property>
                    <child>
                      <object id="pollingGeneralGrid" class="GtkGrid">
                        <property name="row-spacing">6</property>
                        <property name="column-spacing">12</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">&lt;b&gt;General&lt;/b&gt;</property>
                            <property name="use-markup">True</property>
                            <property name="xalign">0</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">Idle time between polling cycles (ms)</property>
                            <property name="xalign">0</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object id="pollIdleTime" class="GtkSpinButton">
                            <property name="numeric">True</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">10000</property>
                                <property name="step-increment">10</property>
                                <property name="page-increment">100</property>
                              </object>
                            </property>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">Low power card detection (LPCD)</property>
                            <property name="xalign">0</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">2</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object id="pollLpcdMode" class="GtkDropDown">
                            <property name="model">
                              <object class="GtkStringList">
                                <items>
                                  <item>Disable</item>
                                  <item>Use in every polling cycle</item>
                                  <item>Use in every n-th cycle</item>
                                </items>
                              </object>
                            </property>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">2</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object id="pollLpcdCycles" class="GtkSpinButton">
                            <property name="numeric">True</property>
                            <property name="tooltip-text">Regular polling in every n-th cycle, LPCD in the other cycles</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">2</property>
                                <property name="upper">255</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">10</property>
                              </object>
                            </property>
                            <layout>
                              <property name="column">2</property>
                              <property name="row">2</property>
                            </layout>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object id="pollingTechGrid" class="GtkGrid">
                        <property name="row-spacing">6</property>
                        <property name="column-spacing">12</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">&lt;b&gt;Technology&lt;/b&gt;</property>
                            <property name="use-markup">True</property>
                            <property name="xalign">0</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">&lt;b&gt;Enabled&lt;/b&gt;</property>
                            <property name="use-markup">True</property>
                            <property name="xalign">0</property>
                            <layout>
                              <property name="column">1</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">&lt;b&gt;Poll every n-th cycle&lt;/b&gt;</property>
                            <property name="use-markup">True</property>
                            <property name="xalign">0</property>
                            <layout>
                              <property name="column">2</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">&lt;b&gt;Max. devices&lt;/b&gt;</property>
                            <property name="use-markup">True</property>
                            <property name="xalign">0</property>
                            <layout>
                              <property name="column">3</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">&lt;b&gt;Bit rate&lt;/b&gt;</property>
                            <property name="use-markup">True</property>
                            <property name="xalign">0</property>
                            <layout>
                              <property name="column">4</property>
                              <property name="row">0</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">Type-A</property>
                            <property name="xalign">0</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object id="pollAEnabled" class="GtkCheckButton">
                            <layout>
                              <property name="column">1</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object id="pollAFrequency" class="GtkSpinButton">
                            <property name="numeric">True</property>
                            <property name="tooltip-text">1 = poll in every cycle</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">1</property>
                                <property name="upper">10</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">10</property>
                              </object>
                            </property>
                            <layout>
                              <property name="column">2</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object id="pollADevices" class="GtkSpinButton">
                            <property name="numeric">True</property>
                            <property name="tooltip-text">Max. number of devices resolved per cycle</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">1</property>
                                <property name="upper">5</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">10</property>
                              </object>
                            </property>
                            <layout>
                              <property name="column">3</property>
                              <property name="row">1</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">Type-B</property>
                            <property name="xalign">0</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">2</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object id="pollBEnabled" class="GtkCheckButton">
                            <layout>
                              <property name="column">1</property>
                              <property name="row">2</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object id="pollBFrequency" class="GtkSpinButton">
                            <property name="numeric">True</property>
                            <property name="tooltip-text">1 = poll in every cycle</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">1</property>
                                <property name="upper">10</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">10</property>
                              </object>
                            </property>
                            <layout>
                              <property name="column">2</property>
                              <property name="row">2</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object id="pollBDevices" class="GtkSpinButton">
                            <property name="numeric">True</property>
                            <property name="tooltip-text">Max. number of devices resolved per cycle</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">1</property>
                                <property name="upper">5</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">10</property>
                              </object>
                            </property>
                            <layout>
                              <property name="column">3</property>
                              <property name="row">2</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">Type-F</property>
                            <property name="xalign">0</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">3</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object id="pollFEnabled" class="GtkCheckButton">
                            <layout>
                              <property name="column">1</property>
                              <property name="row">3</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object id="pollFFrequency" class="GtkSpinButton">
                            <property name="numeric">True</property>
                            <property name="tooltip-text">1 = poll in every cycle</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">1</property>
                                <property name="upper">10</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">10</property>
                              </object>
                            </property>
                            <layout>
                              <property name="column">2</property>
                              <property name="row">3</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object id="pollFDevices" class="GtkSpinButton">
                            <property name="numeric">True</property>
                            <property name="tooltip-text">Max. number of devices resolved per cycle</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">1</property>
                                <property name="upper">5</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">10</property>
                              </object>
                            </property>
                            <layout>
                              <property name="column">3</property>
                              <property name="row">3</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">8</property>
                            <child>
                              <object id="pollF212" class="GtkCheckButton">
                                <property name="label">212 kbit/s</property>
                              </object>
                            </child>
                            <child>
                              <object id="pollF424" class="GtkCheckButton">
                                <property name="label">424 kbit/s</property>
                                <property name="group">pollF212</property>
                              </object>
                            </child>
                            <layout>
                              <property name="column">4</property>
                              <property name="row">3</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">Type-V</property>
                            <property name="xalign">0</property>
                            <layout>
                              <property name="column">0</property>
                              <property name="row">4</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object id="pollVEnabled" class="GtkCheckButton">
                            <layout>
                              <property name="column">1</property>
                              <property name="row">4</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object id="pollVFrequency" class="GtkSpinButton">
                            <property name="numeric">True</property>
                            <property name="tooltip-text">1 = poll in every cycle</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">1</property>
                                <property name="upper">10</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">10</property>
                              </object>
                            </property>
                            <layout>
                              <property name="column">2</property>
                              <property name="row">4</property>
                            </layout>
                          </object>
                        </child>
                        <child>
                          <object id="pollVDevices" class="GtkSpinButton">
                            <property name="numeric">True</property>
                            <property name="tooltip-text">Max. number of devices resolved per cycle</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">1</property>
                                <property name="upper">5</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">10</property>
                              </object>
                            </property>
                            <layout>
                              <property name="column">3</property>
                              <property name="row">4</property>
                            </layout>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <child>
                          <object id="pollingRestoreDefaults" class="GtkButton">
                            <property name="label">RESTORE DEFAULTS</property>
                          </object>
                        </child>
                        <child>
                          <object id="pollingNote" class="GtkLabel">
                            <property name="label">Changes apply when discovery is started next time.</property>
                            <property name="xalign">0</property>
                            <property name="wrap">True</property>
                            <property name="hexpand">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">discovery</property>
            <property name="title">Discovery</property>
            <property name="child">
              <object id="contentBox" class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object id="controlsBox" class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">4</property>
                    <property name="margin-start">4</property>
                    <property name="margin-end">4</property>
                    <property name="margin-top">4</property>
                    <property name="margin-bottom">4</property>
                    <child>
                      <object id="startstop" class="GtkButton">
                        <property name="label">START</property>
                      </object>
                    </child>
                    <child>
                      <object id="reset" class="GtkButton">
                        <property name="label">RESET</property>
                        <property name="action-name">app.reset</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object id="cardStatus" class="GtkLabel">
                    <property name="xalign">0</property>
                    <property name="wrap">True</property>
                    <property name="margin-start">4</property>
                    <property name="margin-end">4</property>
                    <property name="margin-bottom">4</property>
                  </object>
                </child>
                <child>
                  <object id="scrollableArea" class="GtkScrolledWindow">
                    <property name="hexpand">True</property>
                    <property name="vexpand">True</property>
                    <property name="margin-start">4</property>
                    <property name="margin-end">4</property>
                    <property name="margin-bottom">4</property>
                    <child>
                      <object id="cardTable" class="GtkGrid">
                        <property name="column-spacing">16</property>
                        <property name="row-spacing">4</property>
                        <property name="margin-start">4</property>
                        <property name="margin-end">4</property>
                        <property name="margin-top">4</property>
                        <property name="margin-bottom">4</property>
                        <property name="valign">start</property>
                        <property name="halign">start</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">ndef</property>
            <property name="title">NDEF</property>
            <property name="child">
              <object id="ndefBox" class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <child>
                  <object id="ndefReadFrame" class="GtkFrame">
                    <property name="hexpand">True</property>
                    <property name="vexpand">True</property>
                    <property name="margin-start">4</property>
                    <property name="margin-end">4</property>
                    <property name="margin-top">4</property>
                    <property name="margin-bottom">4</property>
                    <child type="label">
                      <object id="ndefControlsBox" class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">4</property>
                        <child>
                          <object id="ndefRead" class="GtkButton">
                            <property name="label">READ</property>
                            <property name="tooltip-text">Start discovery and read the NDEF message of activated cards</property>
                          </object>
                        </child>
                        <child>
                          <object id="ndefStop" class="GtkButton">
                            <property name="label">STOP</property>
                            <property name="tooltip-text">Stop discovery</property>
                          </object>
                        </child>
                        <child>
                          <object id="ndefReadClear" class="GtkButton">
                            <property name="label">CLEAR</property>
                            <property name="tooltip-text">Clear the NDEF read output</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object id="ndefReadBox" class="GtkBox">
                        <property name="orientation">vertical</property>
                        <child>
                          <object id="ndefScrollableArea" class="GtkScrolledWindow">
                            <property name="hexpand">True</property>
                            <property name="vexpand">True</property>
                            <property name="margin-start">4</property>
                            <property name="margin-end">4</property>
                            <property name="margin-bottom">4</property>
                            <child>
                              <object id="ndefText" class="GtkTextView">
                                <property name="editable">False</property>
                                <property name="wrap-mode">word</property>
                                <property name="cursor-visible">False</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object id="ndefWriteFrame" class="GtkFrame">
                    <property name="hexpand">True</property>
                    <property name="vexpand">True</property>
                    <property name="margin-start">4</property>
                    <property name="margin-end">4</property>
                    <property name="margin-bottom">4</property>
                    <child type="label">
                      <object id="ndefWriteControlsBox" class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <child>
                          <object id="ndefWrite" class="GtkButton">
                            <property name="label">WRITE</property>
                            <property name="tooltip-text">Start discovery and write the NDEF message to the first activated card</property>
                          </object>
                        </child>
                        <child>
                          <object id="ndefWriteEditControls" class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">4</property>
                            <child>
                              <object id="ndefWriteType" class="GtkDropDown">
                                <property name="tooltip-text">Record type</property>
                              </object>
                            </child>
                            <child>
                              <object id="ndefWriteAdd" class="GtkButton">
                                <property name="label">ADD</property>
                                <property name="tooltip-text">Add a record with the values below to the message</property>
                              </object>
                            </child>
                            <child>
                              <object id="ndefWriteRemove" class="GtkButton">
                                <property name="label">REMOVE</property>
                                <property name="tooltip-text">Remove the selected record from the message</property>
                              </object>
                            </child>
                            <child>
                              <object id="ndefWriteClear" class="GtkButton">
                                <property name="label">CLEAR</property>
                                <property name="tooltip-text">Remove all records from the message</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object id="ndefWriteBox" class="GtkBox">
                        <property name="orientation">vertical</property>
                        <child>
                          <object id="ndefWriteEditor" class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="vexpand">True</property>
                            <child>
                              <object id="ndefWriteFields" class="GtkGrid">
                                <property name="row-spacing">4</property>
                                <property name="column-spacing">8</property>
                                <property name="margin-start">4</property>
                                <property name="margin-end">4</property>
                                <property name="margin-bottom">4</property>
                              </object>
                            </child>
                            <child>
                              <object id="ndefWriteRecordsScroll" class="GtkScrolledWindow">
                                <property name="hexpand">True</property>
                                <property name="vexpand">True</property>
                                <property name="min-content-height">60</property>
                                <property name="margin-start">4</property>
                                <property name="margin-end">4</property>
                                <property name="margin-bottom">4</property>
                                <child>
                                  <object id="ndefWriteRecords" class="GtkListBox">
                                    <property name="selection-mode">single</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object id="ndefWriteRawBytes" class="GtkLabel">
                                <property name="label">Raw bytes: -</property>
                                <property name="xalign">0</property>
                                <property name="wrap">True</property>
                                <property name="wrap-mode">char</property>
                                <property name="selectable">True</property>
                                <property name="margin-start">4</property>
                                <property name="margin-end">4</property>
                                <property name="margin-bottom">4</property>
                                <style>
                                  <class name="monospace"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object id="ndefWriteActionsBox" class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">4</property>
                            <property name="margin-end">4</property>
                            <property name="margin-bottom">4</property>
                            <child>
                              <object id="ndefWriteStatus" class="GtkLabel">
                                <property name="label">Add records and press WRITE to write them to a card.</property>
                                <property name="xalign">0</property>
                                <property name="wrap">True</property>
                                <property name="hexpand">True</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">hce</property>
            <property name="title">HCE</property>
            <property name="child">
              <object id="hceTabBox" class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object id="hceFrame" class="GtkFrame">
                    <property name="hexpand">True</property>
                    <property name="vexpand">True</property>
                    <property name="margin-start">4</property>
                    <property name="margin-end">4</property>
                    <property name="margin-bottom">4</property>
                    <child type="label">
                      <object id="hceControlsBox" class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <child>
                          <object id="hceStartStop" class="GtkButton">
                            <property name="label">START</property>
                            <property name="tooltip-text">Start/stop emulating a Type 4 Tag with the NDEF message below</property>
                          </object>
                        </child>
                        <child>
                          <object id="hceEditControls" class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">4</property>
                            <child>
                              <object id="hceType" class="GtkDropDown">
                                <property name="tooltip-text">Record type</property>
                              </object>
                            </child>
                            <child>
                              <object id="hceAdd" class="GtkButton">
                                <property name="label">ADD</property>
                                <property name="tooltip-text">Add a record with the values below to the message</property>
                              </object>
                            </child>
                            <child>
                              <object id="hceRemove" class="GtkButton">
                                <property name="label">REMOVE</property>
                                <property name="tooltip-text">Remove the selected record from the message</property>
                              </object>
                            </child>
                            <child>
                              <object id="hceClear" class="GtkButton">
                                <property name="label">CLEAR</property>
                                <property name="tooltip-text">Remove all records from the message</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object id="hceBox" class="GtkBox">
                        <property name="orientation">vertical</property>
                        <child>
                          <object id="hceEditor" class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="vexpand">True</property>
                            <child>
                              <object id="hceFields" class="GtkGrid">
                                <property name="row-spacing">4</property>
                                <property name="column-spacing">8</property>
                                <property name="margin-start">4</property>
                                <property name="margin-end">4</property>
                                <property name="margin-bottom">4</property>
                              </object>
                            </child>
                            <child>
                              <object id="hceRecordsScroll" class="GtkScrolledWindow">
                                <property name="hexpand">True</property>
                                <property name="vexpand">True</property>
                                <property name="min-content-height">60</property>
                                <property name="margin-start">4</property>
                                <property name="margin-end">4</property>
                                <property name="margin-bottom">4</property>
                                <child>
                                  <object id="hceRecords" class="GtkListBox">
                                    <property name="selection-mode">single</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object id="hceRawBytes" class="GtkLabel">
                                <property name="label">Raw bytes: -</property>
                                <property name="xalign">0</property>
                                <property name="wrap">True</property>
                                <property name="wrap-mode">char</property>
                                <property name="selectable">True</property>
                                <property name="margin-start">4</property>
                                <property name="margin-end">4</property>
                                <property name="margin-bottom">4</property>
                                <style>
                                  <class name="monospace"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object id="hceActionsBox" class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">8</property>
                            <property name="margin-start">4</property>
                            <property name="margin-end">4</property>
                            <property name="margin-bottom">4</property>
                            <child>
                              <object id="hceStatus" class="GtkLabel">
                                <property name="label">Add records and press START to emulate them.</property>
                                <property name="xalign">0</property>
                                <property name="wrap">True</property>
                                <property name="hexpand">True</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkFrame">
                    <property name="label">Message written by reader</property>
                    <property name="hexpand">True</property>
                    <property name="vexpand">False</property>
                    <property name="margin-start">4</property>
                    <property name="margin-end">4</property>
                    <property name="margin-bottom">4</property>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="hexpand">True</property>
                        <property name="vexpand">True</property>
                        <property name="min-content-height">80</property>
                        <child>
                          <object id="hceWrittenText" class="GtkTextView">
                            <property name="editable">False</property>
                            <property name="wrap-mode">word</property>
                            <property name="cursor-visible">False</property>
                            <property name="buffer">
                              <object class="GtkTextBuffer">
                                <property name="text">No message written yet.</property>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkFrame">
                    <property name="label">Emulation log</property>
                    <property name="hexpand">True</property>
                    <property name="vexpand">True</property>
                    <property name="margin-start">4</property>
                    <property name="margin-end">4</property>
                    <property name="margin-bottom">4</property>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="hexpand">True</property>
                        <property name="vexpand">True</property>
                        <property name="min-content-height">100</property>
                        <child>
                          <object id="hceLog" class="GtkTextView">
                            <property name="editable">False</property>
                            <property name="wrap-mode">word</property>
                            <property name="cursor-visible">False</property>
                            <style>
                              <class name="monospace"/>
                            </style>
                            <property name="buffer">
                              <object class="GtkTextBuffer">
                                <property name="text"></property>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
